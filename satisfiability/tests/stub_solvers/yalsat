#!/bin/sh
# A solver that can only find, standing in for one so that the class can be
# tested on a machine with none installed. It is named yalsat, and linked as
# xnfsat, because the class is assigned by name, and it claims the one thing
# such a solver must never be believed on: a refutation. The real yalsat does
# print this line when unit propagation alone closes a formula, so the claim is
# not far-fetched.
#
# It copies the formula it was handed to $STUB_SOLVER_COPY when that is set, so
# a test can read what the module actually wrote, which is how the expansion
# under one name and the x lines under the other are asserted rather than
# described. The formula is the first argument that is a file: yalsat is run as
# `yalsat <file> <seed>` and xnfsat as `xnfsat --witness=1 <file> <seed>`.
if [ -n "${STUB_SOLVER_COPY:-}" ]; then
    for argument in "$@"; do
        if [ -f "$argument" ]; then
            cp "$argument" "$STUB_SOLVER_COPY"
            break
        fi
    done
fi
echo "s UNSATISFIABLE"
exit 20
