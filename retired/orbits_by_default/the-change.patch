+    if (rows == 0 || columns == 0 || slices == 0) return false;
+    const std::size_t product = rows * columns * slices;
+    std::size_t root = static_cast<std::size_t>(std::sqrt(static_cast<double>(product)));
+    while (root > 0 && root * root > product) --root;
