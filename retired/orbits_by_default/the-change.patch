+    shape[0] = root / columns;   // n
+    shape[1] = root / slices;    // m
+    shape[2] = root / rows;      // k
+    return shape[0] * shape[1] == rows && shape[1] * shape[2] == columns &&
+           shape[2] * shape[0] == slices;
+}
