# The HTML explainers are written for one reader and never shipped.
explain/

build/
*.o
*.a

# Julia
Manifest.toml

# Python bytecode, from running the frozen original for comparison
__pycache__/
*.pyc

# LaTeX intermediates. The PDF is committed; everything else regenerates.
article/*.aux
article/*.log
article/*.out
article/*.fls
article/*.fdb_latexmk
article/*.bbl
article/*.blg
article/*.synctex.gz

# What the browser console writes while it runs: one directory per run, holding
# the command, the output and any operators the tool emitted. Generated, and
# sometimes large, so it is regenerated rather than carried.
web_interface/runs/
build-cuda/

# Agent worktrees live inside the repo directory; they are checkouts, not content.
.claude/

# The compile database clangd reads, written by -DCMAKE_EXPORT_COMPILE_COMMANDS=ON.
# Generated, machine-specific, and a symlink into a build directory that is
# already ignored.
compile_commands.json

# clangd's index, written beside the compile database it reads.
.cache/
